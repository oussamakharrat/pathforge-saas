# ============================================================
# Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in all values before running

# Server Configuration
# PORT: The port the NestJS server listens on
PORT=5000

# Database Configuration - PostgreSQL/Supabase
# DATABASE_URL: Connection string used for pooled connections (recommended for production)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"

# DIRECT_URL: Direct connection string for Prisma migrations and schema generation
# This should bypass connection pooling
# Format: postgresql://user:password@host:port/database
DIRECT_URL="postgresql://username:password@host:port/database"

# Authentication - JWT Configuration
# JWT_SECRET: Secret key for signing/verifying JWT tokens
# IMPORTANT: Use a strong, random secret in production. Generate with: openssl rand -base64 32
# This is REQUIRED - no default fallback is provided
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"

# JWT_EXPIRES_IN: Token expiration time (see ms package for format)
# Examples: "7d", "24h", "30m"
JWT_EXPIRES_IN="7d"

# CORS Configuration
# CORS_ORIGINS: Comma-separated list of allowed origins for CORS requests
# IMPORTANT: Explicitly define all allowed origins. No localhost fallback in production.
# Examples: "https://app.pathforge.dev,https://www.pathforge.dev"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Node Environment
# NODE_ENV: Environment type (development, staging, production)
# Used for conditional logic like exposing tokens in dev mode
NODE_ENV="development"

# ============================================================
# Optional Advanced Configuration
# ============================================================

# Logging
# LOG_LEVEL: Log verbosity (debug, verbose, log, warn, error)
# LOG_LEVEL="log"

# Database Retry Configuration (if using connection pooling)
# DATABASE_POOL_MIN: Minimum number of connections in pool
# DATABASE_POOL_MAX: Maximum number of connections in pool
# DATABASE_POOL_IDLE_TIMEOUT: Idle connection timeout in ms
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=20
# DATABASE_POOL_IDLE_TIMEOUT=30000

# API Rate Limiting (if implemented)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# External Services (AI, Email, etc.) - Add as needed
# OPENAI_API_KEY="sk-..."
# SENDGRID_API_KEY="SG..."
# STRIPE_API_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
